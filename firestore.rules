rules_version = '2';

// Role-based rules for the request portal.
// Admins do everything. Clients only ever see and create their own requests.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Reads the caller's own user document (users/{uid}) to find their role.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && me().role == 'admin';
    }

    function myClientId() {
      return me().clientId;
    }

    // ── users ──────────────────────────────────────────────
    // You read your own record; admins read anyone. Only admins write.
    match /users/{uid} {
      allow read:  if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── clients ────────────────────────────────────────────
    match /clients/{clientId} {
      allow read:  if isAdmin() || (signedIn() && myClientId() == clientId);
      allow write: if isAdmin();
    }

    // ── requests ───────────────────────────────────────────
    // Clients see only their own, and may create one that starts as 'New'.
    // They cannot set the status themselves or edit it afterwards — that's the admin's job.
    match /requests/{requestId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.clientId == myClientId());

      allow create: if isAdmin()
                    || (signedIn()
                        && request.resource.data.clientId == myClientId()
                        && request.resource.data.status == 'New');

      allow update, delete: if isAdmin();
    }
  }
}
